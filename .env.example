# Goldrush API key — sign up at https://goldrush.dev (Vibe Coding plan, $10/mo).
# Same key works for both Sentry402 and AgentGuard402.
GOLDRUSH_API_KEY=

# x402 receiving wallet on Base Sepolia. Demo placeholder uses zero address.
X402_PAY_TO_ADDRESS=

# Optional: override pre-flight check price (in USDC atoms, 6 decimals).
# Default is 20000 = $0.02. AgentGuard's price point is intentionally lower
# than Sentry402's $0.05 dossier — this is meant to be called inline before
# every transfer, not as a one-off audit.
PREFLIGHT_PRICE_ATOMS=20000
